# Runtime databases — regenerated by `database/migrate.php` on startup.
# Tenant databases in particular must never be committed: they are the
# physical isolation boundary and may contain real client data.
/storage/db/*.sqlite
/storage/db/*.sqlite-*

# JWT signing secret, generated on first run.
/storage/app.key

# Runtime logs.
/storage/logs/*

# Claude Code local tool permission cache — machine-specific, not project config.
/.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
